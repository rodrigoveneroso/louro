# Whisper model: tiny, base, small (default: base)
# LOURO_MODEL=base

# Compute device: auto, cpu, cuda (default: auto)
# LOURO_DEVICE=auto

# Precision: auto, int8, float16, float32 (default: auto, the fastest the hardware
# supports: int8 on a CPU, about twice as fast as float32 with the same accuracy).
# LOURO_COMPUTE_TYPE=auto

# Bind address (default: 127.0.0.1). The API has no authentication, so anything other
# than loopback puts your meeting transcripts on the network.
# LOURO_HOST=127.0.0.1

# Only Louro's own extension may use the backend (its id is fixed by the key in
# extension/manifest.json). Ids of other copies to allow, comma separated (default: none).
# LOURO_EXTENSION_IDS=

# Language of your meetings: pt, en, ko, ja, zh, etc. (default: auto-detect).
# There is no picker in the side panel; setting it here avoids wrong auto-detection.
# LOURO_LANGUAGE=pt

# Seconds between transcription passes while the live captions are open (default: 10)
# LOURO_CHUNK_INTERVAL=10
# ...and between batches while they are closed (default: 300; 0 keeps it always live).
# The work is the same either way; batches keep the machine quiet during the meeting.
# LOURO_IDLE_INTERVAL=300

# CPU priority of the backend (default: 10, low), so the call always comes first.
# LOURO_NICE=10

# Where the database and the working files live (default: recordings/ in this folder)
# LOURO_DATA_DIR=~/.local/share/louro

# Folder that receives a markdown copy of every finished transcript (default: off)
# LOURO_EXPORT_DIR=~/meetings/transcripts

# Captures shorter than this many seconds, or without any speech, are dropped when they
# stop (default: 30). 0 keeps every capture.
# LOURO_MIN_DURATION_SEC=30

# Names, acronyms and jargon Whisper should expect, comma separated. On Google Meet the
# participants' names are added on their own.
# LOURO_VOCABULARY=Kubernetes, PostgreSQL, OKR
# ...or a file with one term per line (# starts a comment), re-read every session.
# LOURO_VOCABULARY_FILE=~/meetings/vocabulary.txt

# A larger Whisper model that transcribes the whole meeting again after Stop, replacing
# the live transcript (default: off). large-v3-turbo made half the errors of the live
# small in our measurement, at about half the meeting's length of CPU work afterwards.
# LOURO_FINAL_MODEL=large-v3-turbo
# Its beam size (default: 1; turbo skipped whole sentences with 5).
# LOURO_FINAL_BEAM=1

# A shell command run after each meeting's markdown export. It gets LOURO_TRANSCRIPT,
# LOURO_SESSION_ID, LOURO_TITLE and LOURO_DURATION_SEC in its environment;
# its output goes to on-export.log in the data folder. Keep the single quotes: this file
# is read by a shell, which would otherwise run the command right there.
# LOURO_ON_EXPORT='claude -p "Summarise $LOURO_TRANSCRIPT" > "${LOURO_TRANSCRIPT%.md}.summary.md"'
