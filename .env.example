# Required for summary generation (Step 5)
# GHOSTMEET_ANTHROPIC_KEY=sk-ant-...

# Whisper model: tiny, base, small (default: base)
# GHOSTMEET_MODEL=base

# Compute device: auto, cpu, cuda (default: auto)
# GHOSTMEET_DEVICE=auto

# Precision: float32, float16, int8 (default: float32). int8 is much faster on CPU.
# GHOSTMEET_COMPUTE_TYPE=float32

# Bind address (default: 127.0.0.1). The API has no authentication, so anything other
# than loopback puts your meeting transcripts on the network.
# GHOSTMEET_HOST=127.0.0.1

# Language of your meetings: pt, en, ko, ja, zh, etc. (default: auto-detect).
# There is no picker in the side panel; setting it here avoids wrong auto-detection.
# GHOSTMEET_LANGUAGE=pt

# Chunk interval in seconds for near-real-time transcription (default: 10)
# Lower = faster captions but more CPU, Higher = more accurate but delayed
# GHOSTMEET_CHUNK_INTERVAL=10

# Folder that receives a markdown copy of every finished transcript (default: off)
# GHOSTMEET_EXPORT_DIR=~/meetings/transcripts

# Captures shorter than this many seconds, or without any speech, are dropped when they
# stop (default: 30). 0 keeps every capture.
# GHOSTMEET_MIN_DURATION_SEC=30

# Names, acronyms and jargon Whisper should expect, comma separated. On Google Meet the
# participants' names are added on their own.
# GHOSTMEET_VOCABULARY=ClickHouse, Metabase, OKR
# ...or a file with one term per line (# starts a comment), re-read every session.
# GHOSTMEET_VOCABULARY_FILE=~/meetings/vocabulary.txt

# A larger Whisper model that transcribes the whole meeting again after Stop, replacing
# the live transcript (default: off). Slow on CPU: a good fraction of the meeting's length.
# GHOSTMEET_FINAL_MODEL=medium

# A shell command run after each meeting's markdown export. It gets GHOSTMEET_TRANSCRIPT,
# GHOSTMEET_SESSION_ID, GHOSTMEET_TITLE and GHOSTMEET_DURATION_SEC in its environment;
# its output goes to on-export.log in the data folder.
# GHOSTMEET_ON_EXPORT=claude -p "Summarise $GHOSTMEET_TRANSCRIPT" > "${GHOSTMEET_TRANSCRIPT%.md}.summary.md"
