{
  "manifest_version": 3,
  "name": "Louro",
  "version": "1.1.3",
  "description": "__MSG_extDescription__",
  "default_locale": "pt_BR",
  "key": "",
  "permissions": [
    "tabCapture",
    "activeTab",
    "storage",
    "sidePanel",
    "offscreen",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "ws://127.0.0.1/*",
    "https://meet.google.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "mark-moment": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "__MSG_commandMark__"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/icon32.png"],
      "matches": ["https://meet.google.com/*"],
      "use_dynamic_url": true
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "meet-dom.js",
        "overlay-state.js",
        "note-input.js",
        "meet-overlay.js",
        "meet-call.js",
        "meet-speakers.js",
        "meet-chat.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
